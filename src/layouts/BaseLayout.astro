---
import '../styles/global.css';
import EventBanner from '../components/EventBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';
import { siteConfig, THEME_COLORS } from '../utils/site';
import { absoluteUrl, withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  /** OpenGraph 이미지 경로 (/images/... 또는 https://...) */
  image?: string | null;
  type?: 'website' | 'article';
  /** 마크다운 미러 등 대체 표현 경로 */
  markdownPath?: string;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.siteDescription,
  image,
  type = 'website',
  markdownPath,
  jsonLd = [],
  publishedTime,
  noindex = false,
} = Astro.props;

const { themePreset, headingFont, defaultViewMode, heroStyle } = siteConfig.design;
const pageTitle = title ? `${title} | ${siteConfig.siteTitle}` : siteConfig.siteTitle;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
// SVG는 SNS 미리보기에서 지원되지 않는 경우가 많아 PNG 기본 이미지로 대체합니다.
const rasterImage = image && !/\.svg($|\?)/i.test(image) ? image : null;
const heroRaster = siteConfig.heroImage && !/\.svg($|\?)/i.test(siteConfig.heroImage) ? siteConfig.heroImage : null;
const ogImage = absoluteUrl(rasterImage ?? heroRaster ?? '/images/og-default.png', Astro.site);
const themeColor = THEME_COLORS[themePreset].background;
const viewStorageKey = `sindorim-view-pref-${defaultViewMode}`;
---
<!doctype html>
<html lang="ko" data-theme={themePreset} data-heading-font={headingFont} data-hero={heroStyle} data-view={defaultViewMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={withBase('/llms.txt')} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={withBase(markdownPath)} />}

    <!-- OpenGraph / Twitter -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.siteTitle} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title ?? siteConfig.siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteConfig.siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 한글 웹폰트 (Pretendard, Gowun Batang) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap" />

    <!-- 방문자 보기 모드: 운영자 기본값이 바뀌면 키도 바뀌므로 새 기본 화면이 우선 적용됩니다. -->
    <script is:inline define:vars={{ viewStorageKey, defaultViewMode }}>
      (function () {
        var mode = defaultViewMode;
        try {
          var saved = localStorage.getItem(viewStorageKey);
          if (saved === 'grid' || saved === 'list') mode = saved;
        } catch (e) {}
        document.documentElement.setAttribute('data-view', mode);
      })();
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-full focus:bg-surface focus:px-4 focus:py-2">본문 바로가기</a>
    <EventBanner />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <SearchModal />
  </body>
</html>
