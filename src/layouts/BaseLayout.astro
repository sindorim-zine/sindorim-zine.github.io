---
import '../styles/global.css';
import EventBanner from '../components/EventBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';
import { siteConfig, THEME_COLORS } from '../utils/site';
import { BODY_FONT_DEFS, HEADING_FONT_DEFS, fontStylesheets, type FontDef } from '../utils/fonts';
import { absoluteUrl, withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  /** OpenGraph 이미지 경로 (/images/... 또는 https://...) */
  image?: string | null;
  type?: 'website' | 'article';
  /** 마크다운 미러 등 대체 표현 경로 */
  markdownPath?: string;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.siteDescription,
  image,
  type = 'website',
  markdownPath,
  jsonLd = [],
  publishedTime,
  noindex = false,
} = Astro.props;

const { themePreset, headingFont, bodyFont, defaultViewMode, heroStyle } = siteConfig.design;
// 운영자가 고른 제목·본문 서체 (고른 서체만 내려받음)
const headingDef: FontDef = HEADING_FONT_DEFS[headingFont];
const bodyDef: FontDef = BODY_FONT_DEFS[bodyFont];
const fontCss = fontStylesheets(headingFont, bodyFont);
const fontVars = `--font-heading:${headingDef.stack};--font-body:${bodyDef.stack};--heading-weight:${headingDef.singleWeight ? 400 : 700};${headingDef.sizeAdjust ? `--heading-size-adjust:${headingDef.sizeAdjust};` : ''}`;
const pageTitle = title ? `${title} | ${siteConfig.siteTitle}` : siteConfig.siteTitle;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
// SVG는 SNS 미리보기에서 지원되지 않는 경우가 많아 PNG 기본 이미지로 대체합니다.
const rasterImage = image && !/\.svg($|\?)/i.test(image) ? image : null;
const heroRaster = siteConfig.heroImage && !/\.svg($|\?)/i.test(siteConfig.heroImage) ? siteConfig.heroImage : null;
const ogImage = absoluteUrl(rasterImage ?? heroRaster ?? '/images/og-default.png', Astro.site);
const themeColor = THEME_COLORS[themePreset].background;
const viewStorageKey = `sindorim-view-pref-${defaultViewMode}`;
---
<!doctype html>
<html lang="ko" data-theme={themePreset} data-heading-font={headingFont} data-body-font={bodyFont} data-heading-weight={headingDef.singleWeight ? 'regular' : 'bold'} data-hero={heroStyle} data-view={defaultViewMode} style={fontVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <meta name="generator" content={Astro.generator} />
    {/* 검색엔진 소유 확인 (CMS 기본 설정 → 검색엔진 소유 확인 코드) */}
    {siteConfig.verification.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
    {siteConfig.verification.naver && <meta name="naver-site-verification" content={siteConfig.verification.naver} />}
    {siteConfig.verification.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={withBase('/llms.txt')} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={withBase(markdownPath)} />}

    <!-- OpenGraph / Twitter -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.siteTitle} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title ?? siteConfig.siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteConfig.siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 한글 웹폰트: CMS에서 고른 제목·본문 서체만 불러옵니다 (모두 OFL 무료 폰트) -->
    {fontCss.some((u) => u.includes('jsdelivr')) && <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />}
    {fontCss.some((u) => u.includes('googleapis')) && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {fontCss.some((u) => u.includes('googleapis')) && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fontCss.map((href) => <link rel="preload" as="style" href={href} />)}
    {fontCss.map((href) => <link rel="stylesheet" href={href} />)}

    <!-- 방문자 보기 모드: 운영자 기본값이 바뀌면 키도 바뀌므로 새 기본 화면이 우선 적용됩니다. -->
    <script is:inline define:vars={{ viewStorageKey, defaultViewMode }}>
      (function () {
        var mode = defaultViewMode;
        try {
          var saved = localStorage.getItem(viewStorageKey);
          if (saved === 'grid' || saved === 'list') mode = saved;
        } catch (e) {}
        document.documentElement.setAttribute('data-view', mode);
      })();
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-full focus:bg-surface focus:px-4 focus:py-2">본문 바로가기</a>
    <EventBanner />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <SearchModal />

    <!-- 행사 D-day: 방문자가 보는 날짜(한국 시간) 기준으로 계산 -->
    <script is:inline>
      (function () {
        var today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
        function days(a, b) { return Math.round((Date.parse(b) - Date.parse(a)) / 86400000); }
        // '더 보기'로 새로 그린 카드에도 다시 쓸 수 있게 전역 함수로 둡니다.
        window.sindorimFillDday = function (root) {
        (root || document).querySelectorAll('[data-event-line]').forEach(function (el) {
          var start = el.getAttribute('data-start'), end = el.getAttribute('data-end') || start;
          var badge = el.querySelector('[data-dday]');
          if (!start || !badge) return;
          var state, text;
          if (end < today) { state = 'ended'; text = '종료'; }
          else if (start <= today) { state = 'ongoing'; text = start === end ? '오늘' : '진행 중'; }
          else { var d = days(today, start); state = d <= 7 ? 'soon' : 'upcoming'; text = 'D-' + d; }
          badge.textContent = text;
          badge.hidden = false;
          el.setAttribute('data-state', state);
        });
        };
        window.sindorimFillDday(document);
      })();
    </script>
  </body>
</html>
