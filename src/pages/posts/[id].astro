---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Illustration from '../../components/Illustration.astro';
import EventBadge from '../../components/EventBadge.astro';
import { eventOf, formatDate, getPublishedPosts, illustrationFor, siteConfig, splitSummary, thumbnailOf, type Post } from '../../utils/site';
import { blogPostingSchema, breadcrumbSchema, eventSchema } from '../../utils/schema';
import { isHttpUrl, postMarkdownPath, postPath, withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, summary, category, pubDate, originalUrl, pinned } = post.data;
const thumb = thumbnailOf(post);
const thumbInBody = !!thumb && (post.body ?? '').includes(thumb);
const event = eventOf(post);
const summaryLines = splitSummary(summary);
const sourceUrl = isHttpUrl(originalUrl) ? originalUrl : siteConfig.cafeUrl;
const jsonLd = [
  blogPostingSchema(post, Astro.site),
  ...(eventSchema(post, Astro.site) ? [eventSchema(post, Astro.site)!] : []),
  breadcrumbSchema(
    [
      { name: '홈', path: '/' },
      { name: title, path: postPath(post.id) },
    ],
    Astro.site,
  ),
];
---
<BaseLayout
  title={title}
  description={summary || siteConfig.siteDescription}
  image={thumb}
  type="article"
  markdownPath={postMarkdownPath(post.id)}
  publishedTime={pubDate.toISOString()}
  jsonLd={jsonLd}
>
  <article class="pb-4 pt-10 md:pt-16" data-pagefind-body>
    <header class="container-prose">
      <nav class="mb-6 text-sm text-muted" aria-label="현재 위치" data-pagefind-ignore>
        <a href={withBase('/')} class="hover:text-ink">홈</a>
        <span class="mx-1.5" aria-hidden="true">/</span>
        <span>{category}</span>
      </nav>
      <div class="flex flex-wrap items-center gap-1.5">
        {pinned && <span class="chip chip-pinned"><Icon name="pin" size={12} />중요 안내</span>}
        <span class="chip" data-pagefind-filter="카테고리">{category}</span>
      </div>
      <h1 class="mt-4 text-[1.85rem] font-bold leading-snug sm:text-4xl">{title}</h1>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <span class="inline-flex items-center gap-1"><Icon name="calendar" size={14} /><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
        <span aria-hidden="true">·</span>
        <span>{siteConfig.representativeName}</span>
      </p>
      {event && (
        <div class="event-box mt-5">
          <EventBadge event={event} size="lg" />
        </div>
      )}
    </header>

    {/* 대표 사진이 본문에도 들어 있으면 위쪽에 한 번 더 보여 주지 않습니다(같은 사진 중복 방지). */}
    {!thumbInBody && (
    <div class="container-prose mt-8">
      <div class="aspect-[16/10] overflow-hidden rounded-[var(--radius-card)] border border-line bg-subtle">
        {thumb ? (
          <img src={withBase(thumb)} alt={`${title} 대표 사진`} width="1200" height="750" class="h-full w-full object-contain" fetchpriority="high" decoding="async" data-pagefind-meta="image[src]" />
        ) : (
          <Illustration variant={illustrationFor(category)} class="h-full w-full" label={`${category} 기본 일러스트`} />
        )}
      </div>
    </div>
    )}

    {summaryLines.length > 0 && (
      <aside class="container-prose mt-8" aria-labelledby="ai-summary-title">
        <div class="rounded-[var(--radius-card)] border border-line bg-accent-soft/60 p-5 sm:p-6">
          <p id="ai-summary-title" class="mb-3 flex items-center gap-1.5 text-sm font-bold text-accent">
            <Icon name="sparkle" size={16} /> AI 핵심 3줄 요약
          </p>
          <ul class="space-y-2">
            {summaryLines.map((line) => (
              <li class="flex gap-2 leading-relaxed">
                <span class="mt-[0.7em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}

    <div class="container-prose prose-body mt-10">
      <Content />
    </div>
  </article>

  <section class="container-prose mt-12" aria-label="네이버 카페에서 이어가기">
    <div class="card flex flex-col items-center gap-4 p-8 text-center">
      <span class="grid h-12 w-12 place-items-center rounded-full bg-accent-soft text-accent"><Icon name="chat" size={22} /></span>
      <p class="font-heading text-xl font-bold">이 소식에 대한 이야기는 카페에서 나눠요</p>
      <p class="max-w-md text-sm text-muted">댓글, 참여 신청, 자세한 일정은 네이버 카페 원문에서 확인하고 함께할 수 있습니다.</p>
      {sourceUrl ? (
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          네이버 카페 원문에서 댓글로 함께하기 <Icon name="external" size={15} />
        </a>
      ) : (
        <a href={withBase('/about')} class="btn btn-ghost">커뮤니티 소개 보기</a>
      )}
    </div>
    {/* 행사 포스터·전단지·현장 안내용: 이 글로 바로 오는 QR (펼칠 때만 이미지를 불러옵니다) */}
    <details class="qr-share mt-6 rounded-[var(--radius-card)] border border-line p-4 text-sm" data-pagefind-ignore>
      <summary class="cursor-pointer font-semibold text-muted hover:text-ink">📱 QR로 이 글 공유하기</summary>
      <div class="mt-4 flex flex-col items-center gap-3 text-center">
        <img src={withBase(`/qr/posts/${post.id}.png`)} alt={`${title} 글로 연결되는 QR 코드`} width="200" height="200" loading="lazy" decoding="async" class="rounded-lg border border-line bg-white p-1" />
        <p class="text-muted">휴대폰 카메라로 찍으면 이 글이 바로 열립니다. 포스터·전단지에 넣어 쓰세요.</p>
        <a class="btn btn-ghost text-sm" href={withBase(`/qr/posts/${post.id}.png`)} download={`sinker-qr-${post.id}.png`}>고해상도 QR 이미지 받기</a>
      </div>
    </details>
    <p class="mt-8 text-center">
      <a href={withBase('/')} class="inline-flex items-center gap-1 text-sm font-semibold text-muted hover:text-ink">← 최신 소식 목록으로</a>
    </p>
  </section>
</BaseLayout>
