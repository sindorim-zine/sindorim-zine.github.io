---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---
<BaseLayout title="페이지를 찾을 수 없습니다" noindex>
  <section class="container-prose flex flex-col items-center gap-5 py-28 text-center">
    <p class="eyebrow">404</p>
    <h1 class="text-3xl font-bold">요청하신 페이지를 찾을 수 없습니다</h1>
    <p class="text-muted">주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <a href={withBase('/')} class="btn btn-primary">홈으로 가기</a>
  </section>
</BaseLayout>
