---
import Icon from './Icon.astro';
import { about, siteConfig } from '../utils/site';
import { withBase } from '../utils/url';

const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-subtle/60">
  <div class="container-page grid gap-8 py-12 md:grid-cols-[1.4fr_1fr]">
    <div class="space-y-3">
      <p class="font-heading text-lg font-bold">{siteConfig.siteTitle}</p>
      {siteConfig.footerText && <p class="max-w-xl text-sm leading-relaxed text-muted">{siteConfig.footerText}</p>}
      <p class="flex items-center gap-1.5 text-sm text-muted">
        <Icon name="map-pin" size={15} />
        {about.locationInfo}
      </p>
    </div>
    <div class="flex flex-col gap-2 text-sm md:items-end">
      <a class="text-muted hover:text-ink" href={withBase('/about')}>커뮤니티 소개</a>
      {siteConfig.cafeUrl && (
        <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href={siteConfig.cafeUrl} target="_blank" rel="noopener noreferrer">
          네이버 카페 바로가기 <Icon name="external" size={13} />
        </a>
      )}
      <a class="text-muted hover:text-ink" href={withBase('/llms.txt')}>llms.txt (AI용 요약)</a>
      <a class="text-muted hover:text-ink" href={withBase('/sitemap-index.xml')}>사이트맵</a>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="container-page py-5 text-xs text-muted">© {year} {siteConfig.representativeName}. All rights reserved.</p>
  </div>
</footer>
