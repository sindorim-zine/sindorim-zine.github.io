---
import Illustration from './Illustration.astro';
import Icon from './Icon.astro';
import EventBadge from './EventBadge.astro';
import { eventOf, formatDate, illustrationFor, publishedTime, thumbnailOf, type Post } from '../utils/site';
import { postPath, withBase } from '../utils/url';

interface Props {
  post: Post;
  eager?: boolean;
}
const { post, eager = false } = Astro.props;
const { title, summary, category, pubDate, pinned, external } = post.data;
const thumb = thumbnailOf(post);
const event = eventOf(post);
---
<li
  class="feed-item"
  data-category={category}
  data-date={pubDate.getTime()}
  data-published={publishedTime(post)}
  data-id={post.id}
  data-title={title}
  data-event-start={event?.start}
  data-event-end={event?.end}
>
  <a href={withBase(postPath(post.id))} class="feed-card card group">
    <div class="feed-media">
      {thumb ? (
        <img
          src={withBase(thumb)}
          alt={`${title} 대표 사진`}
          width="400"
          height="500"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <Illustration variant={illustrationFor(category)} />
      )}
    </div>
    <div class="feed-body">
      <div class="flex flex-wrap items-center gap-1.5">
        {pinned && <span class="chip chip-pinned"><Icon name="pin" size={12} />중요 안내</span>}
        <span class="chip">{category}</span>
        {external && <span class="chip chip-external" title="신도림 커뮤니티가 주최하지 않는 외부 행사 소식입니다">외부 행사</span>}
      </div>
      <h3 class="feed-title">{title}</h3>
      {event && <EventBadge event={event} />}
      {summary && <p class="feed-summary">{summary}</p>}
      <p class="feed-meta">
        <Icon name="calendar" size={13} />
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </p>
    </div>
  </a>
</li>
